<!-- Example -->
<group name="local,syslog,sshd,">
	<!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
	<rule id="100001" level="5">
		<if_sid>5716</if_sid>
		<srcip>1.1.1.1</srcip>
		<description>sshd: authentication failed from IP 1.1.1.1.</description>
		<group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
	</rule>
</group>
<group name="local,syscheck,ransomware,">
	<rule id="100110" level="13" frequency="40" timeframe="30" ignore="120">
		<if_matched_group>syscheck</if_matched_group>
		<same_location />
		<description>Possible ransomware: 40+ file changes in 30s on $(agent.name)</description>
		<mitre>
			<id>T1486</id>
		</mitre>
	</rule>
</group>
<group name="local,syscheck,vt_scan,">
	<rule id="100120" level="5">
		<if_sid>554</if_sid>
		<field name="file" type="pcre2">(?i)^c:\\labdrop\\</field>
		<description>New file in drop folder: $(file)</description>
		<mitre>
			<id>T1204.002</id>
		</mitre>
	</rule>
	<rule id="100121" level="5">
		<if_sid>550</if_sid>
		<field name="file" type="pcre2">(?i)^c:\\labdrop\\</field>
		<description>File modified in drop folder: $(file)</description>
		<mitre>
			<id>T1204.002</id>
		</mitre>
	</rule>
</group>
<group name="local,windows,defender_tamper,">
	<rule id="100130" level="12">
		<if_group>windows</if_group>
		<field name="win.system.eventID">^5001$</field>
		<description>Defender real-time protection disabled on $(agent.name)</description>
		<mitre>
			<id>T1562.001</id>
		</mitre>
	</rule>
	<rule id="100131" level="12">
		<if_group>windows</if_group>
		<field name="win.system.eventID">^5010$|^5012$</field>
		<description>Defender antispyware/antivirus scanning disabled on $(agent.name)</description>
		<mitre>
			<id>T1562.001</id>
		</mitre>
	</rule>
	<rule id="100132" level="10">
		<if_group>windows</if_group>
		<field name="win.system.eventID">^5007$</field>
		<field name="win.eventdata.new Value" type="pcre2">(?i)Exclusions</field>
		<description>Defender exclusion added on $(agent.name): $(win.eventdata.new Value)</description>
		<mitre>
			<id>T1562.001</id>
		</mitre>
	</rule>
	<rule id="100133" level="10">
		<if_group>windows</if_group>
		<field name="win.system.eventID">^5013$</field>
		<description>Tamper Protection blocked a Defender change on $(agent.name)</description>
		<mitre>
			<id>T1562.001</id>
		</mitre>
	</rule>
</group>
<group name="local,windows,authentication,">
	<rule id="100140" level="10" frequency="8" timeframe="60">
		<if_matched_sid>60122</if_matched_sid>
		<same_field>win.system.computer</same_field>
		<different_field>win.eventdata.targetUserName</different_field>
		<description>Possible password spray: 8+ failed logons across different users on $(win.system.computer) in 60s</description>
		<mitre>
			<id>T1110.003</id>
		</mitre>
	</rule>
	<rule id="100141" level="13" timeframe="120">
		<if_matched_sid>100140</if_matched_sid>
		<if_sid>60106,92652</if_sid>
		<same_field>win.system.computer</same_field>
		<field name="win.eventdata.targetUserName" type="pcre2" negate="yes">(?i)(\$$|^ANONYMOUS LOGON$)</field>
		<field name="win.eventdata.ipAddress" type="pcre2" negate="yes">^(::1|fe80:|127\.0\.0\.1|-)</field>
		<description>Password spray then SUCCESSFUL logon on $(win.system.computer): $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
		<mitre>
			<id>T1110.003</id>
			<id>T1078</id>
		</mitre>
	</rule>
</group>
